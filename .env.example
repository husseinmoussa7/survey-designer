# ── LLM API Keys ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── Qualtrics (required for survey deployment) ───────────────────────────────
QUALTRICS_API_TOKEN=your_qualtrics_api_token
QUALTRICS_DATA_CENTER=your_datacenter_id      # e.g. iad1, ca1
QUALTRICS_DIRECTORY_ID=your_directory_id

# ── AWS / MTurk (required for MTurk HIT creation) ────────────────────────────
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
MTURK_SANDBOX=True    # True = sandbox mode, False = real experiment

# ── Pipeline settings ─────────────────────────────────────────────────────────
PAPERS_DIR=papers                   # path to papers/training and papers/test directories

# ── Cross-paper memory (optional) ────────────────────────────────────────────
SURVEY_CROSS_MEMORY=0               # Set to 1 to inject training memory into Step 2
SURVEY_CROSS_MEMORY_MAX=20          # Max number of other papers to include
SURVEY_CROSS_MEMORY_TRAINING_ONLY=1 # 1 = exclude test papers from cross-memory

# ── Knowledge sources (optional) ─────────────────────────────────────────────
KNOWLEDGE_DIR=knowledge             # directory containing reference PDFs
